---
import { hatchId, niceMax, niceTicks, topRounded, wrapLabel } from '../../lib/chart';

export interface Bar {
  id: string;
  label: string;
  value: number;
  display: string;
  color: string;
  mark: string;
  hatched?: boolean;
  href?: string;
  tip: string;
}

interface Props {
  bars: Bar[];
  max?: number;
  slotWidth?: number;
  plotHeight?: number;
  labelArea?: number;
  showAxis?: boolean;
  axisFmt?: (v: number) => string;
  breakAbove?: number;
  minWidth?: number;
  ariaLabel: string;
}

const {
  bars,
  slotWidth: slot = 52,
  plotHeight = 260,
  labelArea = 118,
  showAxis = false,
  axisFmt = (v: number) => String(v),
  breakAbove,
  minWidth = 0,
  ariaLabel,
} = Astro.props;

const unbroken = bars.filter((b) => breakAbove === undefined || b.value <= breakAbove).map((b) => b.value);
const max = Astro.props.max ?? niceMax(Math.max(...unbroken, 1));
const COS = Math.cos((52 * Math.PI) / 180);
const SIN = Math.sin((52 * Math.PI) / 180);
const CHAR = 6.5;
const wrapped = bars.map((b) => wrapLabel(b.label, 15, 3));
const lineLen = (ls: string[]) => Math.max(...ls.map((l) => l.length));
const baseL = showAxis ? 46 : 6;
const leftExtent = (ls: string[]) => (ls.length - 1) * 5 + Math.max(...ls.map((l, j) => l.length * CHAR * COS - j * 12.5 * SIN)) - 4;
const overhang = Math.max(0, ...wrapped.map((ls, i) => leftExtent(ls) - (baseL + i * slot + slot / 2) + 4));
const padL = baseL + overhang;
const padT = 30;
const longest = Math.max(...wrapped.map(lineLen));
const area = Math.max(labelArea, Math.round(longest * CHAR * SIN + 52));
const width = padL + bars.length * slot + 6;
const height = padT + plotHeight + area;
const baseY = padT + plotHeight;
const barW = Math.round(slot * 0.74);
const ticks = niceTicks(0, max, 4);
const colors = [...new Set(bars.filter((b) => b.hatched).map((b) => b.color))];

const geo = bars.map((b, i) => {
  const lines = wrapped[i];
  const broken = breakAbove !== undefined && b.value > breakAbove;
  const h = broken ? plotHeight + 14 : Math.max(2, (Math.max(0, b.value) / max) * plotHeight);
  const x = padL + i * slot + (slot - barW) / 2;
  const y = baseY - h;
  const inside = !b.hatched && h >= 26 && barW >= b.display.length * 6.6 + 4;
  return { ...b, broken, h, x, y, inside, cx: x + barW / 2, lines };
});
---

<div class="chart-scroll" style={`--min-w:${minWidth}px`}>
  <svg viewBox={`0 0 ${width} ${height}`} width="100%" role="img" aria-label={ariaLabel} class="bars">
    <defs>
      {
        colors.map((c) => (
          <pattern id={hatchId(c)} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <rect width="6" height="6" fill={c} fill-opacity="0.12" />
            <line x1="0" y1="0" x2="0" y2="6" stroke={c} stroke-width="2.4" stroke-opacity="0.7" />
          </pattern>
        ))
      }
    </defs>
    {
      ticks.map((t) => (
        <g>
          <line class="grid" x1={padL} x2={width - 4} y1={baseY - (t / max) * plotHeight} y2={baseY - (t / max) * plotHeight} />
          {showAxis && (
            <text class="axis" x={padL - 10} y={baseY - (t / max) * plotHeight + 4} text-anchor="end">
              {axisFmt(t)}
            </text>
          )}
        </g>
      ))
    }
    <line class="base" x1={padL} x2={width - 4} y1={baseY} y2={baseY} />
    {
      geo.map((b) => (
        <a href={b.href} class="bar" data-tip={b.tip} aria-label={`${b.label}: ${b.display}`}>
          <rect x={b.x - 4} y={padT - 24} width={barW + 8} height={plotHeight + area + 20} fill="transparent" />
          <path
            d={topRounded(b.x, b.y, barW, b.h, 3)}
            fill={b.hatched ? `url(#${hatchId(b.color)})` : b.color}
            stroke={b.hatched ? b.color : 'none'}
            stroke-dasharray={b.hatched ? '3 2.5' : undefined}
            stroke-width={b.hatched ? 1.3 : 0}
          />
          {b.broken && (
            <g class="break">
              <path d={`M${b.x - 3},${padT + 12} l${barW / 4 + 1.5},-5 l${barW / 4 + 1.5},5 l${barW / 4 + 1.5},-5 l${barW / 4 + 1.5},5`} />
              <path d={`M${b.x - 3},${padT + 18} l${barW / 4 + 1.5},-5 l${barW / 4 + 1.5},5 l${barW / 4 + 1.5},-5 l${barW / 4 + 1.5},5`} />
            </g>
          )}
          {b.inside ? (
            <text class="val in" x={b.cx} y={b.y + 17} text-anchor="middle">
              {b.display}
            </text>
          ) : (
            <text class:list={['val', 'out', { claim: b.hatched }]} x={b.cx} y={b.y - 7} text-anchor="middle">
              {b.display}
            </text>
          )}
          <circle class="mark-bg" cx={b.cx} cy={baseY + 16} r="9.5" />
          <text class="mark" x={b.cx} y={baseY + 19.6} text-anchor="middle" fill={b.color}>
            {b.mark}
          </text>
          <text class="lbl" transform={`translate(${b.cx + 4 - (b.lines.length - 1) * 5} ${baseY + 34}) rotate(-52)`} text-anchor="end">
            {b.lines.map((l, j) => (
              <tspan x="0" dy={j === 0 ? 0 : 12.5}>
                {l}
              </tspan>
            ))}
          </text>
        </a>
      ))
    }
  </svg>
</div>

<style>
  .bars {
    overflow: visible;
  }
  .grid {
    stroke: var(--grid);
    stroke-dasharray: 3 4;
  }
  .base {
    stroke: var(--line-strong);
  }
  .axis {
    fill: var(--muted);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }
  .bar path {
    transition: opacity 0.15s;
  }
  .bar:hover path {
    opacity: 0.82;
  }
  .val {
    font-size: 11.5px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .val.in {
    fill: #fff;
  }
  .val.out {
    fill: var(--ink);
  }
  .val.claim {
    fill: var(--muted);
    font-style: italic;
  }
  .mark-bg {
    fill: var(--bg-pill);
  }
  .mark {
    font-size: 10.5px;
    font-weight: 800;
    font-family: var(--sans);
  }
  .lbl {
    fill: var(--ink-2);
    font-size: 11.5px;
  }
  .bar:hover .lbl {
    fill: var(--ink);
    font-weight: 600;
  }
  .break path {
    fill: none;
    stroke: var(--surface);
    stroke-width: 2.4;
  }
</style>
