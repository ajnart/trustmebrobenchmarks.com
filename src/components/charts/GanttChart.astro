---
import { rightRounded } from '../../lib/chart';
import { BUILD_DATE } from '../../lib/scores';

export interface Span {
  id: string;
  label: string;
  sub: string;
  color: string;
  start: string;
  end?: string;
  href?: string;
  tip: string;
}

interface Props {
  rows: Span[];
  ariaLabel: string;
}

const { rows, ariaLabel } = Astro.props;
const DAY = 86_400_000;
const W = 1240;
const rowH = 46;
const m = { l: 260, r: 120, t: 40, b: 24 };
const iw = W - m.l - m.r;
const H = m.t + rows.length * rowH + m.b;
const t0 = Math.min(...rows.map((r) => Date.parse(r.start))) - 40 * DAY;
const t1 = BUILD_DATE.getTime() + 20 * DAY;
const X = (t: number) => m.l + ((t - t0) / (t1 - t0)) * iw;

const ticks: number[] = [];
const d = new Date(t0);
d.setUTCDate(1);
d.setUTCMonth(Math.ceil(d.getUTCMonth() / 3) * 3);
for (; d.getTime() < t1; d.setUTCMonth(d.getUTCMonth() + 3)) if (d.getTime() > t0) ticks.push(d.getTime());
const fmt = (t: number) => new Date(t).toLocaleDateString('en-GB', { month: 'short', year: '2-digit', timeZone: 'UTC' }).replace(' ', " '");
const today = BUILD_DATE.getTime();

const spans = rows.map((r) => {
  const s = Date.parse(r.start);
  const e = r.end ? Date.parse(r.end) : today;
  const days = Math.max(0, Math.round((e - s) / DAY));
  return { ...r, s, e, days, open: !r.end };
});
---

<div class="chart-scroll" style="--min-w:820px">
  <svg viewBox={`0 0 ${W} ${H}`} width="100%" role="img" aria-label={ariaLabel} class="gantt">
    <defs>
      {
        spans
          .filter((s) => s.open)
          .map((s) => (
            <linearGradient id={`fade-${s.id}`} x1="0" x2="1">
              <stop offset="0" stop-color={s.color} stop-opacity="0.85" />
              <stop offset="1" stop-color={s.color} stop-opacity="0.18" />
            </linearGradient>
          ))
      }
    </defs>
    {
      ticks.map((t) => (
        <g>
          <line class="grid" x1={X(t)} x2={X(t)} y1={m.t - 10} y2={H - m.b} />
          <text class="tick" x={X(t)} y={m.t - 18} text-anchor="middle">
            {fmt(t)}
          </text>
        </g>
      ))
    }
    <line class="today" x1={X(today)} x2={X(today)} y1={m.t - 10} y2={H - m.b} />
    <text class="today-l" x={X(today) + 6} y={H - m.b - 4}>this build</text>
    {
      spans.map((s, i) => {
        const y = m.t + i * rowH;
        const x1 = X(s.s);
        const w = Math.max(4, X(s.e) - x1);
        return (
          <a href={s.href} class="row" data-tip={s.tip}>
            <rect class="hit" x="0" y={y} width={W} height={rowH} />
            <text class="lbl" x={m.l - 18} y={y + rowH / 2} text-anchor="end">
              {s.label}
            </text>
            <text class="sub" x={m.l - 18} y={y + rowH / 2 + 15} text-anchor="end">
              {s.sub}
            </text>
            <path d={rightRounded(x1, y + 13, w, rowH - 26, 4)} fill={s.open ? `url(#fade-${s.id})` : s.color} />
            <circle cx={x1} cy={y + rowH / 2} r="4.5" fill={s.color} stroke="var(--surface)" stroke-width="2" />
            {s.open ? (
              <text class="days open" x={x1 + w + 10} y={y + rowH / 2 + 4.5}>
                {s.days}d and counting →
              </text>
            ) : (
              <text class="days" x={x1 + w + 10} y={y + rowH / 2 + 4.5}>
                {s.days === 0 ? 'same day' : `${s.days}d`}
              </text>
            )}
          </a>
        );
      })
    }
  </svg>
</div>

<style>
  .grid {
    stroke: var(--grid);
    stroke-dasharray: 2 4;
  }
  .tick {
    fill: var(--muted);
    font-size: 12px;
  }
  .today {
    stroke: var(--bad);
    stroke-width: 1.5;
    stroke-dasharray: 4 3;
  }
  .today-l {
    fill: var(--bad);
    font-size: 11px;
    font-weight: 600;
  }
  .hit {
    fill: transparent;
  }
  .row:hover .hit {
    fill: var(--bg-subtle);
  }
  .lbl {
    fill: var(--ink);
    font-size: 13.5px;
    font-weight: 550;
    dominant-baseline: auto;
  }
  .sub {
    fill: var(--muted);
    font-size: 11.5px;
  }
  .days {
    fill: var(--ink-2);
    font-size: 12.5px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .days.open {
    fill: var(--bad);
  }
</style>
