---
import Logo from './Logo.astro';
import { REPO_URL, NEW_ISSUE_URL } from '../lib/site';

const path = Astro.url.pathname;
const nav = [
  { href: '/models/', label: 'Models' },
  { href: '/benchmarks/', label: 'Benchmarks' },
  { href: '/incidents/', label: 'Incidents' },
  { href: '/in-the-wild/', label: 'In the Wild' },
  { href: '/methodology/', label: 'Methodology' },
];
const active = (href: string) => path.startsWith(href);
---

<div class="satire">
  <div class="container satire-in">
    <span><b>Satire.</b> Every score on this site is made up. The tweets are real.</span>
    <a href="/methodology/#disclaimer">Read the disclaimer →</a>
  </div>
</div>
<header class="top">
  <div class="container top-in">
    <a href="/" class="brand" aria-label="Trust Me Bro Benchmarks home">
      <Logo size={20} />
      <span>Trust Me Bro</span>
    </a>
    <nav class="nav" aria-label="Main">
      <div class="nav-group">
        {
          nav.map((n) => (
            <a href={n.href} class:list={['nav-link', { on: active(n.href) }]}>
              {n.label}
            </a>
          ))
        }
      </div>
      <a href="/chart-crime-studio/" class:list={['nav-link', 'nav-solo', { on: active('/chart-crime-studio/') }]}>Chart Crime Studio</a>
    </nav>
    <div class="actions">
      <a class="pill pill-accent hide-sm" href={NEW_ISSUE_URL} target="_blank" rel="noopener">Get Verified</a>
      <a class="pill pill-ink" href={REPO_URL} target="_blank" rel="noopener" aria-label="Contribute on GitHub">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"
          ><path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path></svg
        >
        <span class="hide-xs">Contribute</span>
      </a>
      <button class="icon-btn" id="theme-toggle" aria-label="Toggle dark mode">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"
          ><circle cx="12" cy="12" r="8.5"></circle><path d="M12 3.5v17a8.5 8.5 0 000-17z" fill="currentColor"></path></svg
        >
      </button>
    </div>
  </div>
  <div class="container mobile-nav">
    {
      [...nav, { href: '/chart-crime-studio/', label: 'Chart Crime Studio' }].map((n) => (
        <a href={n.href} class:list={['nav-link', { on: active(n.href) }]}>
          {n.label}
        </a>
      ))
    }
  </div>
</header>

<style>
  .satire {
    background: var(--ink);
    color: var(--bg);
    font-size: 13px;
  }
  .satire-in {
    display: flex;
    justify-content: center;
    gap: 14px;
    padding-top: 7px;
    padding-bottom: 7px;
    flex-wrap: wrap;
    text-align: center;
  }
  .satire a {
    opacity: 0.7;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .satire a:hover {
    opacity: 1;
  }
  .top {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
  }
  .top-in {
    display: flex;
    align-items: center;
    gap: 20px;
    height: 72px;
  }
  .brand {
    --logo-check: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 40px;
    padding: 0 18px 0 14px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-family: var(--serif);
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .nav {
    flex: 1;
    display: flex;
    justify-content: center;
    gap: 6px;
  }
  .nav-group {
    display: flex;
    background: var(--bg-pill);
    border-radius: 999px;
    padding: 4px;
  }
  .nav-link {
    height: 32px;
    display: inline-flex;
    align-items: center;
    padding: 0 14px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
    color: var(--ink-2);
    white-space: nowrap;
    transition: background 0.15s, color 0.15s;
  }
  .nav-link:hover {
    color: var(--ink);
  }
  .nav-link.on {
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
  }
  .nav-solo {
    height: 40px;
    background: var(--bg-pill);
  }
  .nav-solo.on {
    background: var(--ink);
    color: var(--bg);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .icon-btn {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    border: 0;
    background: var(--bg-pill);
    display: grid;
    place-items: center;
  }
  .icon-btn:hover {
    background: var(--line);
  }
  .mobile-nav {
    display: none;
  }
  @media (max-width: 1180px) {
    .nav {
      display: none;
    }
    .actions {
      margin-left: auto;
    }
    .mobile-nav {
      display: flex;
      gap: 4px;
      overflow-x: auto;
      padding-bottom: 10px;
      scrollbar-width: none;
    }
    .mobile-nav .nav-link {
      background: var(--bg-pill);
    }
    .mobile-nav .nav-link.on {
      background: var(--ink);
      color: var(--bg);
    }
  }
  @media (max-width: 560px) {
    .hide-sm {
      display: none;
    }
    .top-in {
      height: 64px;
    }
  }
  @media (max-width: 380px) {
    .hide-xs {
      display: none;
    }
  }
</style>
