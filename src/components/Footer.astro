---
import Logo from './Logo.astro';
import { REPO_URL, NEW_ISSUE_URL } from '../lib/site';
import { BUILD_ISO } from '../lib/scores';

const cols = [
  {
    title: 'Explore',
    links: [
      { href: '/models/', label: 'Model Leaderboard' },
      { href: '/benchmarks/', label: 'Benchmarks' },
      { href: '/incidents/', label: 'Incident Database' },
      { href: '/in-the-wild/', label: 'In the Wild' },
    ],
  },
  {
    title: 'Products',
    links: [
      { href: '/chart-crime-studio/', label: 'Chart Crime Studio' },
      { href: '/benchmarks/random-axis/', label: 'Random Axis, Re-run' },
      { href: '/benchmarks/benchmaxx-gap/', label: 'Benchmaxx Gap' },
      { href: '/benchmarks/ship-latency/', label: 'Days to Ship' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/methodology/', label: 'Methodology' },
      { href: '/methodology/#disclaimer', label: 'Disclaimer' },
      { href: REPO_URL, label: 'Contribute on GitHub', external: true },
      { href: NEW_ISSUE_URL, label: 'Report a claim', external: true },
    ],
  },
];
---

<footer class="foot">
  <div class="container foot-grid">
    <div class="foot-brand">
      <a href="/" class="brand-row"><Logo size={22} /><span>Trust Me Bro Benchmarks</span></a>
      <p class="tagline">The leaderboard for <a class="link" href="/methodology/#tmbb">TMBBs</a>: benchmarks that ask you to just trust them.</p>
      <p class="credit">
        Made with <a class="link" href="https://claude.ai" target="_blank" rel="noopener">Claude</a>, prompted by
        <a class="link" href="https://github.com/ajnart" target="_blank" rel="noopener">ajnart</a>.
      </p>
    </div>
    {
      cols.map((c) => (
        <div class="foot-col">
          <h4>{c.title}</h4>
          {c.links.map((l) => (
            <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>
              {l.label}
            </a>
          ))}
        </div>
      ))
    }
  </div>
  <div class="container foot-legal">
    <span>© 2026 Trust Me Bro Benchmarks</span>
    <span>Terms of Use: Don't worry bro</span>
    <span>Privacy Policy: Pinky promise</span>
    <span>Not affiliated with Artificial Analysis, who do this properly</span>
    <span class="mono">build {BUILD_ISO}</span>
  </div>
</footer>

<style>
  .foot {
    margin-top: 120px;
    border-top: 1px solid var(--line);
    padding-top: 56px;
    background: var(--bg-subtle);
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 40px;
  }
  .brand-row {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--serif);
    font-size: 22px;
    --logo-check: var(--bg-subtle);
  }
  .foot-brand p {
    margin: 0;
    max-width: 380px;
    color: var(--ink-2);
    font-size: 14.5px;
  }
  .tagline {
    margin-top: 18px !important;
    margin-bottom: 10px !important;
  }
  .credit {
    color: var(--muted) !important;
  }
  .foot-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 14.5px;
  }
  .foot-col h4 {
    margin: 0 0 4px;
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }
  .foot-col a:hover {
    color: var(--accent);
  }
  .foot-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    padding-top: 48px;
    padding-bottom: 40px;
    font-size: 12.5px;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .foot-grid {
      grid-template-columns: 1fr 1fr;
    }
    .foot-brand {
      grid-column: 1 / -1;
    }
  }
</style>
