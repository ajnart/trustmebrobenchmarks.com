---
import { MagicTweet } from '@/components/ui/tweet-card';
import { tweetUrl, type Tweet } from '../data/tweets';
import { fetchTweet } from '../lib/x';
import { compact, shortDate } from '../lib/scores';

interface Props {
  tweet: Tweet;
  class?: string;
  media?: boolean;
}
const { tweet, class: className, media = true } = Astro.props;
const live = await fetchTweet(tweet.id);
const initials = tweet.name.replace(/[^A-Za-z0-9]/g, '').slice(0, 2).toUpperCase() || tweet.handle.slice(0, 2).toUpperCase();
const hue = [...tweet.handle].reduce((a, c) => a + c.charCodeAt(0), 0) % 360;
---

{
  live && (
    <MagicTweet
      tweet={live}
      footer
      media={media}
      className={`tweet bg-card max-w-none gap-3.5 break-inside-avoid p-[18px] transition-[border-color,box-shadow] hover:border-[var(--line-strong)] hover:shadow-[var(--shadow)] ${className ?? ''}`}
    />
  )
}
{
  !live && (
    <figure class:list={['card', 'tw', className]}>
      <header class="tw-head">
        <span class="av" style={`background:hsl(${hue} 32% 88%);color:hsl(${hue} 40% 30%)`}>
          {initials}
        </span>
        <div class="who">
          <b>{tweet.name}</b>
          <span class="muted">@{tweet.handle}</span>
        </div>
      </header>
      <blockquote>{tweet.text}</blockquote>
      <figcaption class="tw-foot">
        <span>{shortDate(tweet.date)}</span>
        <span class="num">♥ {compact(tweet.likes)}</span>
        <a href={tweetUrl(tweet)} target="_blank" rel="noopener" class="open">
          Open on X ↗
        </a>
      </figcaption>
    </figure>
  )
}

<style>
  .tw {
    margin: 0;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    break-inside: avoid;
  }
  .tw-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .av {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 13px;
    font-weight: 700;
    flex: none;
  }
  .who {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    min-width: 0;
    font-size: 15px;
  }
  .who b {
    font-weight: 550;
  }
  .who span {
    font-size: 14px;
  }
  blockquote {
    margin: 0;
    white-space: pre-line;
    font-size: 15px;
    line-height: 1.6;
  }
  .tw-foot {
    display: flex;
    gap: 12px;
    font-size: 13px;
    color: var(--muted);
  }
  .open {
    margin-left: auto;
    color: var(--accent);
    font-weight: 500;
  }
</style>
