---
import '../styles/tailwind.css';
import '../styles/global.css';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CF_BEACON_TOKEN, SITE_NAME } from '../lib/site';
import { BUILD_DATE } from '../lib/scores';
import {
  DEFAULT_DESCRIPTION,
  OG_SIZE,
  SITE_TAGLINE,
  absolute,
  article,
  breadcrumbList,
  graph,
  ogImagePath,
  organization,
  webPage,
  website,
  type Crumb,
  type JsonLd,
} from '../lib/seo';
import type { Tweet } from '../data/tweets';

interface Props {
  title?: string;
  description?: string;
  imageAlt?: string;
  pageType?: string;
  article?: { published: string; type?: string; citations?: Tweet[] };
  breadcrumbs?: Crumb[];
  schema?: JsonLd[];
  noindex?: boolean;
}

const { title, description = DEFAULT_DESCRIPTION, imageAlt, pageType = 'WebPage', article: articleMeta, breadcrumbs = [], schema = [], noindex = false } = Astro.props;

const fullTitle = title ? [`${title} | ${SITE_NAME}`, `${title} | Trust Me Bro`, title].find((t) => t.length <= 62) ?? title : `${SITE_NAME} | ${SITE_TAGLINE}`;
const shareTitle = title ?? `${SITE_NAME}: ${SITE_TAGLINE}`;
const url = absolute(Astro.url.pathname);
const image = absolute(ogImagePath(Astro.url.pathname));
const alt = imageAlt ?? `${shareTitle}. A satirical AI benchmark chart from ${SITE_NAME}.`;
const modified = BUILD_DATE.toISOString();
const isHome = Astro.url.pathname === '/';
const pages = {
  and: [
    { href_matches: '/*' },
    { not: { href_matches: ['/og/*', '/*.png', '/*.ico', '/*.svg', '/*.xml', '/*.txt', '/*.webmanifest'] } },
    { not: { selector_matches: '[target], [download], [data-no-prerender]' } },
  ],
};
const speculation = {
  prefetch: [{ where: pages, eagerness: 'eager' }],
  prerender: [{ where: pages, eagerness: 'moderate' }],
};

const nodes: JsonLd[] = [
  organization(),
  website(),
  webPage({ url, type: isHome ? 'WebPage' : pageType, name: shareTitle, description, image, hasBreadcrumb: !isHome, modified }),
  ...(isHome ? [] : [breadcrumbList(url, breadcrumbs)]),
  ...(articleMeta ? [article({ url, headline: shareTitle, description, image, modified, ...articleMeta })] : []),
  ...schema,
];
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={articleMeta ? 'article' : 'website'} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:secure_url" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_SIZE.width)} />
    <meta property="og:image:height" content={String(OG_SIZE.height)} />
    <meta property="og:image:alt" content={alt} />
    {articleMeta && <meta property="article:published_time" content={articleMeta.published} />}
    {articleMeta && <meta property="article:modified_time" content={modified} />}
    {articleMeta && <meta property="article:section" content="Satire" />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={alt} />
    <link rel="image_src" href={image} />

    <meta name="referrer" content="same-origin" />
    <meta name="author" content={SITE_NAME} />
    <meta name="generator" content={Astro.generator} />
    <meta name="application-name" content={SITE_NAME} />
    <meta name="apple-mobile-web-app-title" content="Trust Me Bro" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <Font cssVariable="--ff-sans" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--ff-serif" preload={[{ subset: 'latin', style: 'normal' }]} />
    <Font cssVariable="--ff-mono" />

    <script type="application/ld+json" set:html={graph(nodes)} />
    <script type="speculationrules" set:html={JSON.stringify(speculation)} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const theme = () => {
          try {
            root.dataset.theme = localStorage.getItem('tmb-theme') ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          } catch {}
        };
        theme();
        document.addEventListener('prerenderingchange', theme);
        addEventListener('pageshow', (e) => e.persisted && theme());

        const KEY = 'tmb-vt';
        const read = (k) => {
          try {
            return JSON.parse(sessionStorage.getItem(k) ?? 'null');
          } catch {
            return null;
          }
        };
        const write = (k, v) => {
          try {
            sessionStorage.setItem(k, JSON.stringify(v));
          } catch {}
        };

        addEventListener(
          'click',
          (e) => {
            const a = e.target instanceof Element && e.target.closest('a[href]');
            if (!a || a.target || a.origin !== location.origin || (a.pathname === location.pathname && a.hash)) return;
            let x = e.clientX;
            let y = e.clientY;
            if (!e.detail) {
              const r = a.getBoundingClientRect();
              x = r.left + r.width / 2;
              y = r.top + r.height / 2;
            }
            write(KEY, { x, y, t: Date.now() });
          },
          true,
        );

        addEventListener('pagereveal', (e) => {
          const vt = e.viewTransition;
          if (!vt) return;
          const act = window.navigation?.activation;
          const fresh = read(KEY);
          try {
            sessionStorage.removeItem(KEY);
          } catch {}
          let mode = 'reveal';
          let p = null;
          if (act?.navigationType === 'traverse' && act.from && act.entry) {
            let key = act.entry.key;
            if (act.entry.index < act.from.index) {
              mode = 'conceal';
              key = act.from.key;
            }
            p = read(`${KEY}:${key}`);
          } else if (fresh && Date.now() - fresh.t < 10000) {
            p = fresh;
            if (act?.entry) write(`${KEY}:${act.entry.key}`, fresh);
          }
          if (!p) return;
          root.dataset.vt = mode;
          const r = Math.hypot(Math.max(p.x, innerWidth - p.x), Math.max(p.y, innerHeight - p.y));
          const clip = [`circle(0px at ${p.x}px ${p.y}px)`, `circle(${r}px at ${p.x}px ${p.y}px)`];
          const depth = [{ transform: 'none', opacity: 1 }, { transform: 'scale(0.985)', opacity: 0.7 }];
          const opts = { duration: 560, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'both' };
          let front = 'new';
          let behind = 'old';
          if (mode === 'conceal') {
            front = 'old';
            behind = 'new';
            clip.reverse();
            depth.reverse();
          }
          vt.ready.then(() => {
            root.animate({ clipPath: clip }, { ...opts, pseudoElement: `::view-transition-${front}(root)` });
            root.animate(depth, { ...opts, pseudoElement: `::view-transition-${behind}(root)` });
          });
          vt.finished.finally(() => delete root.dataset.vt);
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <div class="tip" id="tip" role="tooltip"></div>
    <script>
      const tip = document.getElementById('tip')!;
      let current: Element | null = null;
      const place = (x: number, y: number) => {
        const r = tip.getBoundingClientRect();
        let left = x + 16;
        let top = y + 16;
        if (left + r.width > innerWidth - 8) left = x - r.width - 16;
        if (top + r.height > innerHeight - 8) top = y - r.height - 16;
        tip.style.left = `${Math.max(8, left)}px`;
        tip.style.top = `${Math.max(8, top)}px`;
      };
      document.addEventListener('pointermove', (e) => {
        const el = (e.target as Element | null)?.closest?.('[data-tip]') ?? null;
        if (!el) {
          if (current) tip.classList.remove('on');
          current = null;
          return;
        }
        if (el !== current) {
          current = el;
          tip.innerHTML = el.getAttribute('data-tip') ?? '';
          tip.classList.add('on');
        }
        place(e.clientX, e.clientY);
      });
      document.addEventListener(
        'scroll',
        () => {
          tip.classList.remove('on');
          current = null;
        },
        { passive: true },
      );

      document.getElementById('theme-toggle')?.addEventListener('click', (e) => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        const apply = () => {
          root.dataset.theme = next;
          try {
            localStorage.setItem('tmb-theme', next);
          } catch {}
        };
        if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          apply();
          return;
        }
        const r = (e.currentTarget as HTMLElement).getBoundingClientRect();
        const x = r.left + r.width / 2;
        const y = r.top + r.height / 2;
        const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
        root.dataset.vt = 'theme';
        const t = document.startViewTransition(apply);
        t.ready.then(() =>
          root.animate(
            { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
            { duration: 520, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', pseudoElement: '::view-transition-new(root)' },
          ),
        );
        t.finished.finally(() => delete root.dataset.vt);
      });

      document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((group) => {
        const buttons = group.querySelectorAll<HTMLButtonElement>('[data-tab]');
        const panels = group.querySelectorAll<HTMLElement>('[data-panel]');
        buttons.forEach((b) =>
          b.addEventListener('click', () => {
            buttons.forEach((x) => x.setAttribute('aria-selected', String(x === b)));
            panels.forEach((p) => (p.hidden = p.dataset.panel !== b.dataset.tab));
          }),
        );
      });
    </script>
    {
      import.meta.env.PROD && (
        <script
          is:inline
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: CF_BEACON_TOKEN })}
        />
      )
    }
  </body>
</html>
