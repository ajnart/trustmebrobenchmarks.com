---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { BENCHMARKS } from '../data/benchmarks';
import { AVAILABLE, MODELS } from '../data/models';
import { INDEX_NAME, INDEX_VERSION } from '../lib/site';
import { itemList } from '../lib/seo';
import { modelView } from '../lib/model-view';
import { fmt, money, value } from '../lib/scores';

const cols = BENCHMARKS.filter((b) => b.leaderboard);

const sorted = MODELS.map(modelView).sort((a, b) => (b.index ?? -1) - (a.index ?? -1) || b.model.claimed - a.model.claimed);

const num = (v: number | undefined) => (v === undefined ? '' : String(v));
const available = AVAILABLE.length;
---

<Base
  title="AI Model Leaderboard: Intelligence & Price"
  description={`${MODELS.length} AI models ranked on the ${INDEX_NAME}: GPT-6, Claude, Gemini, Grok, Mistral and more, including several that do not exist yet. Satirical scores.`}
  pageType="CollectionPage"
  breadcrumbs={[{ name: 'Models', path: '/models/' }]}
  schema={[itemList('AI model leaderboard', sorted.map((v) => ({ name: v.name, path: v.href })))]}
>
  <PageHead
    eyebrow="Leaderboard"
    title="Model Leaderboard"
    lede={`${MODELS.length} models: ${available} we could evaluate, and ${MODELS.length - available} we evaluated anyway, using their announcements. Click any column to sort.`}
  />
  <section class="container">
    <div class="card table-card">
      <div class="table-scroll">
        <table class="lb" id="lb">
          <thead>
            <tr>
              <th data-sort="text" class="sticky">Model</th>
              <th data-sort="text">Status</th>
              <th data-sort="num" class="r" aria-sort="descending">{INDEX_NAME.replace('Trust Me Bro ', 'TMB ')}</th>
              <th data-sort="num" class="r">Self-reported</th>
              <th data-sort="num" class="r">Benchmaxx Gap</th>
              {cols.map((b) => <th data-sort="num" class="r">{b.short}</th>)}
              <th data-sort="num" class="r">Speed (tok/s)</th>
              <th data-sort="num" class="r">Cost / task</th>
              <th data-sort="num" class="r">Days to ship</th>
            </tr>
          </thead>
          <tbody>
            {
              sorted.map((v) => {
                const m = v.model;
                return (
                  <tr id={m.id} class:list={{ vapor: v.vapor }}>
                    <td class="sticky" data-v={m.name}>
                      <div class="mcell">
                        <span class="lab-mark" style={`color:${v.lab.color}`}>
                          {v.lab.mark}
                        </span>
                        <div>
                          <a class="mlink vt-name" href={v.href} style={`view-transition-name: m-${m.id}`}>{m.name}</a>
                          {v.variant && <span class="variant"> ({v.variant})</span>}
                          <div class="sub">
                            {v.lab.name}
                            {m.openWeights && ' · Open weights'}
                          </div>
                          {m.note && <div class="note">{m.note}</div>}
                        </div>
                      </div>
                    </td>
                    <td data-v={m.status}>
                      <span class:list={['badge', v.status.badge]}>{v.status.label}</span>
                    </td>
                    <td class="r strong" data-v={num(v.index ?? -1)}>
                      {v.index === undefined ? <span class="muted">n/a</span> : v.index}
                    </td>
                    <td class="r" data-v={num(m.claimed)}>
                      {m.claimLabel ?? m.claimed}
                    </td>
                    <td class="r" data-v={num(v.gap ?? 999)}>
                      {v.gap === undefined ? <span class="inf">{v.gapText}</span> : <span class:list={{ bad: v.gap > 10, good: v.gap <= 0 }}>{v.gapText}</span>}
                    </td>
                    {cols.map((b) => {
                      const x = value(b, m);
                      return (
                        <td class="r" data-v={num(x ?? -1)}>
                          {x === undefined ? <span class="muted">—</span> : fmt(x, b.format)}
                        </td>
                      );
                    })}
                    <td class="r" data-v={num(m.speed)}>
                      {m.speed === 0 && <span class="muted">—</span>}
                      {m.speed > 0 && `${m.speed}${v.vapor ? '*' : ''}`}
                    </td>
                    <td class="r" data-v={num(m.cost || 999)}>
                      {money(m.cost)}
                    </td>
                    <td class="r" data-v={num(v.shipDays)}>
                      {v.shipDays}
                      {!m.released && '+'}
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
    </div>
    <p class="footnote legend-note">
      {INDEX_NAME} {INDEX_VERSION}. Values marked * are claimed rather than measured. "n/a" means the model cannot be used by the public, which has not stopped it from
      being ranked. Overclaim is lower-is-better. Snitch is direction-unclear. Days to ship marked + are still counting.
    </p>
  </section>
</Base>

<script>
  const table = document.getElementById('lb') as HTMLTableElement | null;
  if (table) {
    const headers = [...table.querySelectorAll<HTMLTableCellElement>('th[data-sort]')];
    const body = table.tBodies[0];
    headers.forEach((th, col) => {
      th.tabIndex = 0;
      const sort = () => {
        const dir = th.getAttribute('aria-sort') === 'descending' ? 'ascending' : 'descending';
        headers.forEach((h) => h.removeAttribute('aria-sort'));
        th.setAttribute('aria-sort', dir);
        const isNum = th.dataset.sort === 'num';
        const rows = [...body.rows];
        rows.sort((a, b) => {
          const av = a.cells[col].dataset.v ?? '';
          const bv = b.cells[col].dataset.v ?? '';
          const cmp = isNum ? Number(av) - Number(bv) : av.localeCompare(bv);
          return dir === 'ascending' ? cmp : -cmp;
        });
        rows.forEach((r) => body.appendChild(r));
      };
      th.addEventListener('click', sort);
      th.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          sort();
        }
      });
    });
  }
</script>

<style>
  .table-card {
    padding: 0;
    overflow: hidden;
  }
  .table-scroll {
    overflow-x: auto;
  }
  .lb {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    min-width: 1280px;
  }
  .lb th {
    position: sticky;
    top: 0;
    text-align: left;
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
    padding: 14px 14px;
    border-bottom: 1px solid var(--line);
    background: var(--bg-subtle);
    cursor: pointer;
    white-space: nowrap;
    user-select: none;
  }
  .lb th:hover {
    color: var(--ink);
  }
  .lb th[aria-sort]::after {
    content: ' ↓';
    color: var(--accent);
  }
  .lb th[aria-sort='ascending']::after {
    content: ' ↑';
  }
  .lb td {
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
    font-variant-numeric: tabular-nums;
  }
  .lb tr:last-child td {
    border-bottom: 0;
  }
  .lb tbody tr:hover td {
    background: var(--bg-subtle);
  }
  .lb tr:target td {
    background: var(--accent-soft);
  }
  .r {
    text-align: right !important;
  }
  .strong {
    font-weight: 650;
  }
  .sticky {
    position: sticky;
    left: 0;
    background: var(--surface);
    z-index: 1;
    min-width: 300px;
    max-width: 380px;
  }
  th.sticky {
    z-index: 2;
    background: var(--bg-subtle);
  }
  .mcell {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .lab-mark {
    width: 24px;
    height: 24px;
    flex: none;
    border-radius: 7px;
    background: var(--bg-pill);
    display: grid;
    place-items: center;
    font-size: 11px;
    font-weight: 800;
  }
  .variant {
    color: var(--muted);
  }
  .sub {
    font-size: 12.5px;
    color: var(--muted);
  }
  .note {
    margin-top: 6px;
    font-size: 12.5px;
    color: var(--ink-2);
    line-height: 1.45;
    white-space: normal;
  }
  .mlink {
    font-weight: 650;
  }
  .mlink:hover {
    color: var(--accent);
  }
  .vapor .mlink {
    font-style: italic;
  }
  .inf {
    color: var(--muted);
  }
  .bad {
    color: var(--bad);
    font-weight: 600;
  }
  .good {
    color: var(--good);
    font-weight: 600;
  }
  .legend-note {
    margin-top: 14px;
    max-width: 900px;
  }
</style>
