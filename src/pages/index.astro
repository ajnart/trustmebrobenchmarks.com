---
import Base from '../layouts/Base.astro';
import ChartCard from '../components/ChartCard.astro';
import TabBar from '../components/TabBar.astro';
import TweetCard from '../components/TweetCard.astro';
import { Marquee } from '@/components/ui/marquee';
import BarChart from '../components/charts/BarChart.astro';
import ScatterChart from '../components/charts/ScatterChart.astro';
import DumbbellChart from '../components/charts/DumbbellChart.astro';
import GanttChart from '../components/charts/GanttChart.astro';
import StackedBarChart from '../components/charts/StackedBarChart.astro';
import { ANNOUNCEMENTS, CHANGELOG } from '../data/changelog';
import { BENCHMARKS, INDEX_BENCHMARKS } from '../data/benchmarks';
import { INCIDENTS } from '../data/incidents';
import { lab } from '../data/labs';
import { MODELS } from '../data/models';
import { TWEETS } from '../data/tweets';
import { INDEX_NAME, INDEX_VERSION } from '../lib/site';
import { BUILD_ISO, fmt, indexRows, rows, shortDate } from '../lib/scores';
import { itemList } from '../lib/seo';
import {
  claimDumbbells,
  contextDumbbells,
  costBars,
  costStacks,
  indexBars,
  indexVsClaim,
  indexVsCost,
  indexVsSpeed,
  overTime,
  shipSpans,
  speedBars,
} from '../lib/views';

const marquee = [...TWEETS].filter((t) => t.text.length <= 240).sort((a, b) => b.likes - a.likes).slice(0, 20);
const rowA = marquee.filter((_, i) => i % 2 === 0);
const rowB = marquee.filter((_, i) => i % 2 === 1);
const featuredIncidents = INCIDENTS.filter((i) => ['TMB-2024-0001', 'TMB-2026-0006', 'TMB-2026-0010'].includes(i.id));
const yearFmt = (t: number) => new Date(t).toLocaleDateString('en-GB', { month: 'short', year: '2-digit', timeZone: 'UTC' }).replace(' ', " '");
const usd = (v: number) => `$${v}`;
const evalCount = INDEX_BENCHMARKS.length;
const studioPanels = [
  {
    title: 'The data',
    base: 0,
    lie: '1.0',
    crime: false,
    bars: [
      { cls: 'them', h: 50.1 / 60, label: '50.1', sota: false },
      { cls: 'us', h: 52.8 / 60, label: '52.8', sota: false },
    ],
  },
  {
    title: 'The launch post',
    base: 49.5,
    lie: '83.5',
    crime: true,
    bars: [
      { cls: 'them', h: 0.6 / 3.696, label: '50.1', sota: false },
      { cls: 'us', h: 3.3 / 3.696, label: '52.8*', sota: true },
    ],
  },
];
---

<Base schema={[itemList(`${INDEX_NAME}: released models`, indexRows(false).slice(0, 10).map((r) => ({ name: `${r.model.name}: ${r.value}`, path: `/models/${r.model.id}/` })))]}>
  <section class="container hero">
    <div class="hero-l">
      <a class="status" href="/methodology/">
        <i class="live" aria-hidden="true"></i>
        <span>Index {INDEX_VERSION} · {MODELS.length} models · Updated {shortDate(BUILD_ISO)}</span>
      </a>
      <h1 class="display">Independent<span class="ast">*</span><br />analysis of AI</h1>
      <p class="lede">Understand the AI landscape to choose the best model and provider for your use case. Or for your launch post.</p>
      <p class="hero-foot">* Independent of evidence. {MODELS.length} models, {BENCHMARKS.length} evaluations, 0 reproducible results.</p>
    </div>
    <div class="hero-r">
      {
        ANNOUNCEMENTS.map((a) => (
          <a class="ann" href={a.href}>
            <div>
              <span class="eyebrow">New</span>
              <h3>{a.title}</h3>
              <p>{a.body}</p>
            </div>
            <span class="ann-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="container highlights">
    <ChartCard title="Intelligence" subtitle={`${INDEX_NAME} · Higher is better`} marker="#7c3aed" size="sm" href="#intelligence">
      <BarChart bars={indexBars({ limit: 12 })} slotWidth={40} plotHeight={210} labelArea={112} max={100} breakAbove={100} ariaLabel="Intelligence highlights" />
    </ChartCard>
    <ChartCard title="Speed" subtitle="Output tokens per second · Higher is better" marker="#facc15" size="sm" href="#tradeoffs">
      <BarChart bars={speedBars(12)} slotWidth={40} plotHeight={210} labelArea={112} max={400} breakAbove={400} ariaLabel="Speed highlights" />
    </ChartCard>
    <ChartCard title="Cost per Task" subtitle="Average cost (USD) per TMB Index task · Lower is better" marker="#f97316" size="sm" href="#cost">
      <BarChart bars={costBars(12)} slotWidth={40} plotHeight={210} labelArea={112} ariaLabel="Cost highlights" />
    </ChartCard>
  </section>

  <section class="container duo">
    <a class="card studio" href="/chart-crime-studio/">
      <div class="studio-copy">
        <span class="eyebrow">New tool · Chart Crime Studio</span>
        <h3 class="h2">Make a 2.7-point lead look like a landslide</h3>
        <p>Truncate the y-axis, hide the labels, add an asterisk. Tufte's Lie Factor is computed live, so you know exactly how much you are lying.</p>
      </div>
      <div class="sd" aria-hidden="true">
        {
          studioPanels.map((p) => (
            <figure class:list={['sd-panel', { crime: p.crime }]}>
              <figcaption>
                <b>{p.title}</b>
                <span>y-axis from {p.base}</span>
              </figcaption>
              <div class="sd-plot">
                {p.bars.map((b) => (
                  <div class="sd-col">
                    <div class:list={['sd-bar', b.cls]} style={`--h:${b.h}`}>
                      <span>
                        {b.sota && <em>SOTA</em>}
                        {b.label}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
              <div class="sd-names">
                <span>Them</span>
                <span>Us</span>
              </div>
              <p class="sd-lf">
                Lie Factor <b>{p.lie}</b>
              </p>
            </figure>
          ))
        }
      </div>
      <span class="arrow-link">Open the studio →</span>
    </a>
    <div class="card changelog">
      <h3 class="h3">Changelog</h3>
      <ul>
        {
          CHANGELOG.map((c) => (
            <li>
              <a href={c.href}>
                <span class="cl-kind">
                  {c.kind} · {c.date}
                </span>
                <span class="cl-title">{c.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="container section" id="intelligence">
    <div class="section-head">
      <span class="eyebrow">Intelligence</span>
      <h2 class="h1">{INDEX_NAME}</h2>
      <p>
        {INDEX_NAME} {INDEX_VERSION} incorporates {evalCount} evaluations:{' '}
        {
          INDEX_BENCHMARKS.map((b, i) => (
            <>
              <a class="link" href={`/benchmarks/${b.slug}/`}>
                {b.name}
              </a>
              {i < INDEX_BENCHMARKS.length - 1 ? ', ' : '.'}
            </>
          ))
        }
      </p>
    </div>
    <ChartCard title={INDEX_NAME} subtitle="Higher is better · Hatched bars are self-reported by models that cannot currently be used">
      <div data-tabs>
        <TabBar
          tabs={[
            { id: 'all', label: 'All models' },
            { id: 'released', label: 'Released models only' },
            { id: 'claims', label: 'Self-reported scores' },
          ]}
        />
        <div data-panel="all">
          <BarChart bars={indexBars()} max={100} breakAbove={100} showAxis minWidth={900} ariaLabel="TMB Intelligence Index, all models" />
        </div>
        <div data-panel="released" hidden>
          <BarChart bars={indexBars({ vapor: false })} max={100} showAxis minWidth={900} ariaLabel="TMB Intelligence Index, released models" />
        </div>
        <div data-panel="claims" hidden>
          <BarChart
            bars={[...MODELS]
              .sort((a, b) => b.claimed - a.claimed)
              .map((m) => ({
                id: m.id,
                label: m.variant ? `${m.name} (${m.variant})` : m.name,
                value: m.claimed,
                display: m.claimLabel === 'AGI' ? 'AGI' : String(m.claimed),
                color: lab(m.lab).color,
                mark: lab(m.lab).mark,
                href: `/models/${m.id}/`,
                tip: `<b>${m.name}</b><div class="tip-sub">${lab(m.lab).name}</div><div style="margin-top:6px">Self-reported: ${m.claimLabel ?? m.claimed}</div>`,
              }))}
            max={100}
            breakAbove={100}
            showAxis
            minWidth={900}
            ariaLabel="Self-reported scores"
          />
        </div>
      </div>
      <Fragment slot="foot">
        * Hatched bars: no publicly available API, weights, or evidence. Scored from the announcement. Bars exceeding 100 are truncated with an axis break, a
        courtesy rarely extended in the other direction. Index composition and weights: <a class="link" href="/methodology/#index">Methodology §1</a>.
      </Fragment>
    </ChartCard>
  </section>

  <section class="container section" id="tradeoffs">
    <div class="section-head">
      <span class="eyebrow">Trade-offs</span>
      <h2 class="h1">Intelligence vs. everything else</h2>
      <p>The upper-left is where models are smart and cheap. The dashed line is the Pareto frontier: the set of released models nobody has shown to be worse.</p>
    </div>
    <ChartCard title="Intelligence vs. Cost per Task" subtitle={`${INDEX_NAME} · Cost per task (USD, log scale)`}>
      <div data-tabs>
        <TabBar
          tabs={[
            { id: 'cost', label: 'vs. Cost per Task' },
            { id: 'speed', label: 'vs. Output Speed' },
            { id: 'claim', label: 'vs. Self-reported Score' },
          ]}
        />
        <div data-panel="cost">
          <ScatterChart points={indexVsCost()} xScale="log" better="low" quadrant xLabel="Cost per TMB task (USD, log scale)" yLabel={INDEX_NAME} xFmt={usd} ariaLabel="Index vs cost" />
        </div>
        <div data-panel="speed" hidden>
          <ScatterChart points={indexVsSpeed()} better="high" quadrant xLabel="Output speed (tokens per second)" yLabel={INDEX_NAME} ariaLabel="Index vs speed" />
        </div>
        <div data-panel="claim" hidden>
          <ScatterChart
            points={indexVsClaim()}
            better="low"
            quadrant
            xLabel="Self-reported headline score (launch post, normalized)"
            yLabel={INDEX_NAME}
            ariaLabel="Index vs self-reported score"
          />
        </div>
      </div>
      <Fragment slot="foot">
        How to read this chart: each point is a released model. Further left is cheaper; higher is better on the TMB Index. Models that have not been released are excluded,
        since their cost per task is zero and their intelligence is whatever they said it was.
      </Fragment>
    </ChartCard>
  </section>

  <section class="container section" id="benchmaxx">
    <div class="section-head">
      <span class="eyebrow">New · Benchmaxx Gap</span>
      <h2 class="h1">Self-reported vs. measured</h2>
      <p>The distance between the number in the launch post and the number we measured. Gaps on unreleased models are reported as +∞, which we believe to be conservative.</p>
    </div>
    <ChartCard title="Benchmaxx Gap" subtitle="Launch-post score (hollow) vs. TMB Intelligence Index (solid) · Smaller gap is better" href="/benchmarks/benchmaxx-gap/">
      <DumbbellChart rows={claimDumbbells()} max={100} measuredLabel="TMB Index (measured)" claimedLabel="Self-reported" ariaLabel="Benchmaxx gap" />
    </ChartCard>
  </section>

  <section class="container section" id="ship">
    <div class="section-head">
      <span class="eyebrow">Logistics</span>
      <h2 class="h1">Announce-to-availability latency</h2>
      <p>Calendar days between the first public claim about a model and the first day a member of the public could send it a prompt. Open intervals keep growing every time this site is rebuilt.</p>
    </div>
    <ChartCard title="Days to Ship" subtitle="From first claim to general availability · Lower is better" href="/benchmarks/ship-latency/">
      <GanttChart rows={shipSpans()} ariaLabel="Announce to availability" />
      <Fragment slot="foot">
        Sources for every start date are on the <a class="link" href="/incidents/">incident pages</a>. Reflection 405B was announced as "coming next week" on 5 September 2024.
      </Fragment>
    </ChartCard>
  </section>

  <section class="container section" id="cost">
    <div class="section-head">
      <span class="eyebrow">Cost</span>
      <h2 class="h1">Where the money goes</h2>
      <p>Cost per TMB Index task, segmented by token type. Hedging and apologies are billed at the output rate.</p>
    </div>
    <ChartCard title="Cost per Task, by Token Type" subtitle="USD per TMB Index task · Lower is better">
      <StackedBarChart stacks={costStacks()} axisFmt={(v) => `$${v}`} ariaLabel="Cost per task by token type" />
    </ChartCard>
  </section>

  <section class="container section two">
    <ChartCard title="Context: Advertised vs. Remembered" subtitle="Thousand tokens · Solid: retrieved reliably in our needle test · Hollow: on the pricing page">
      <DumbbellChart
        rows={contextDumbbells().slice(0, 10)}
        max={2000}
        measuredLabel="Remembers"
        claimedLabel="Advertised"
        gapLabel="Forgotten"
        gapFmt={(v) => `${Math.round(v)}k`}
        compact
        ariaLabel="Context advertised vs remembered"
      />
    </ChartCard>
    <ChartCard title="Frontier Intelligence, Over Time" subtitle={`${INDEX_NAME} by release date · Hatched: first claim date of unreleased models`}>
      <ScatterChart points={overTime()} xScale="time" better="low" pareto quadrant={false} xLabel="Release date" yLabel={INDEX_NAME} xFmt={yearFmt} yDomain={[30, 100]} height={560} ariaLabel="Intelligence over time" />
    </ChartCard>
  </section>

  <section class="container section" id="evaluations">
    <div class="section-head">
      <span class="eyebrow">Benchmarks</span>
      <h2 class="h1">Evaluations, measured independently*</h2>
      <p>Each evaluation is inspired by a real meme benchmark that went viral on X. Theirs are real. Ours are not. Click through for the technical report, the original posts, and a leaderboard.</p>
    </div>
    <div class="evals">
      {
        BENCHMARKS.map((b) => {
          const top = rows(b).slice(0, 3);
          return (
            <a class="card ev" href={`/benchmarks/${b.slug}/`}>
              <div class="ev-head">
                <span class="badge">{b.category}</span>
                {b.badge && <span class="badge badge-accent">{b.badge}</span>}
                {b.indexWeight > 0 && <span class="ev-w">Index weight {b.indexWeight}×</span>}
              </div>
              <h3>{b.name}</h3>
              <p>{b.tagline}</p>
              <ol>
                {top.map((r) => (
                  <li>
                    <span class="dot" style={`background:${lab(r.model.lab).color}`} />
                    <span class="ev-m">{r.model.name}</span>
                    <b class="num">{fmt(r.value, b.format)}</b>
                  </li>
                ))}
              </ol>
              {b.inspiredBy && <span class="ev-src">Inspired by {b.inspiredBy.author}</span>}
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="container section" id="wild">
    <div class="section-head">
      <span class="eyebrow">In the wild</span>
      <h2 class="h1">The meme-benchmark era, as it happened</h2>
      <p>Public posts that shaped the field. Verbatim, linked, and the only primary sources on this website.</p>
    </div>
  </section>
  <div class="marquee">
    <Marquee pauseOnHover className="[--duration:110s] [--gap:14px] py-1">
      {rowA.map((t) => <TweetCard tweet={t} media={false} class="w-[380px] shrink-0" />)}
    </Marquee>
    <Marquee reverse pauseOnHover className="[--duration:110s] [--gap:14px] py-1">
      {rowB.map((t) => <TweetCard tweet={t} media={false} class="w-[380px] shrink-0" />)}
    </Marquee>
  </div>
  <section class="container">
    <a class="pill pill-soft more" href="/in-the-wild/">See all {TWEETS.length} posts →</a>
  </section>

  <section class="container section" id="incidents">
    <div class="section-head">
      <span class="eyebrow">Incident database</span>
      <h2 class="h1">Trust Me Bro incidents</h2>
      <p>Documented cases of claims that outran their evidence, with timelines and sources. Also: a registry of benchmarks that did it properly.</p>
    </div>
    <div class="inc">
      {
        featuredIncidents.map((i) => (
          <a class="card inc-row" href={`/incidents/${i.id.toLowerCase()}/`}>
            <span class="mono inc-id">{i.id}</span>
            <div>
              <h3>{i.title}</h3>
              <p>{i.claim}</p>
            </div>
            <span class:list={['badge', i.status === 'Resolved' ? 'badge-good' : i.status === 'Open' ? 'badge-bad' : 'badge-warn']}>{i.status}</span>
          </a>
        ))
      }
    </div>
    <a class="pill pill-soft more" href="/incidents/">Open the incident database →</a>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 440px;
    gap: 48px;
    padding-top: 64px;
    padding-bottom: 56px;
  }
  .ast {
    color: var(--accent);
    font-size: 0.55em;
    vertical-align: super;
    margin-left: 2px;
  }
  .lede {
    margin-top: 28px;
  }
  .hero-l {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .status {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 32px;
    padding: 0 14px 0 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--bg-subtle);
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    transition:
      border-color 0.15s,
      color 0.15s;
  }
  .status:hover {
    border-color: var(--line-strong);
    color: var(--ink);
  }
  .live {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--good);
  }
  .live::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--good);
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes ping {
    75%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }
  .hero-foot {
    margin: 18px 0 0;
    font-size: 13.5px;
    color: var(--muted);
  }
  .hero-r {
    display: flex;
    flex-direction: column;
  }
  .ann {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    padding: 22px 0 26px;
    border-bottom: 1px solid var(--line);
  }
  .ann:first-child {
    padding-top: 6px;
  }
  .ann h3 {
    margin: 6px 0 4px;
    font-size: 17px;
    font-weight: 550;
    line-height: 1.35;
  }
  .ann p {
    margin: 0;
    font-size: 14.5px;
    color: var(--muted);
  }
  .ann-arrow {
    width: 32px;
    height: 32px;
    flex: none;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: var(--bg-pill);
    font-size: 14px;
  }
  .ann:hover h3 {
    color: var(--accent);
  }
  .highlights {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .duo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 16px;
  }
  .studio {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    background: linear-gradient(160deg, var(--accent-soft), var(--surface) 50%);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .studio:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
    box-shadow: var(--shadow-lg);
  }
  .studio-copy {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .studio-copy p {
    margin: 0;
    max-width: 520px;
    color: var(--ink-2);
  }
  .sd {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    min-height: 300px;
  }
  .sd-panel {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 16px 18px 14px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }
  .sd-panel figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 2px 8px;
    font-size: 13px;
    white-space: nowrap;
  }
  .sd-panel figcaption b {
    font-weight: 600;
    color: var(--ink);
  }
  .sd-panel figcaption span {
    font-size: 12px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .crime figcaption span {
    color: var(--bad);
  }
  .sd-plot {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 44px;
    border-bottom: 1px solid var(--line-strong);
    background: repeating-linear-gradient(to top, transparent 0 calc(25% - 1px), var(--grid) calc(25% - 1px) 25%);
  }
  .sd-col {
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }
  .sd-bar {
    position: relative;
    width: min(64px, 70%);
    height: calc(var(--h) * 100%);
    border-radius: 5px 5px 0 0;
    background: var(--faint);
    transition: height 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sd-bar.us {
    background: var(--accent);
  }
  .sd-bar span {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    font-size: 13px;
    font-weight: 650;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .sd-bar em {
    padding: 2px 7px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-size: 9.5px;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .sd-names {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 8px;
    text-align: center;
    font-size: 12px;
    color: var(--muted);
  }
  .sd-lf {
    display: flex;
    justify-content: space-between;
    margin: 12px 0 0;
    padding-top: 10px;
    border-top: 1px solid var(--line);
    font-size: 12.5px;
    color: var(--muted);
  }
  .sd-lf b {
    font-weight: 650;
    color: var(--good);
    font-variant-numeric: tabular-nums;
  }
  .crime .sd-lf b {
    color: var(--bad);
  }
  .studio .arrow-link {
    color: var(--accent);
  }
  .changelog {
    padding: 26px 28px;
  }
  .changelog ul {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
  }
  .changelog li a {
    display: flex;
    flex-direction: column;
    padding: 9px 0;
