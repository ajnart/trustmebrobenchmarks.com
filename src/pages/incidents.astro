---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import IncidentCard from '../components/IncidentCard.astro';
import Ticker from '../components/Ticker.astro';
import { COMMENDATIONS, INCIDENTS, incidentHref } from '../data/incidents';
import { itemList } from '../lib/seo';
import { tweetById, tweetUrl } from '../data/tweets';

const sorted = [...INCIDENTS].sort((a, b) => b.date.localeCompare(a.date));
const counts = INCIDENTS.reduce<Record<string, number>>((acc, i) => ({ ...acc, [i.status]: (acc[i.status] ?? 0) + 1 }), {});
---

<Base
  title="AI Incident Database: Claims vs. Evidence"
  description="Documented cases of AI launch claims that outran their evidence: Reflection 70B, Grok 5, Le Chaton Fat and more, with timelines and primary sources."
  pageType="CollectionPage"
  breadcrumbs={[{ name: 'Incidents', path: '/incidents/' }]}
  schema={[itemList('Trust Me Bro Incident Database', sorted.map((i) => ({ name: i.title, path: incidentHref(i) })))]}
>
  <PageHead
    eyebrow="Incident database"
    title="Trust Me Bro Incident Database"
    lede="Documented cases of claims that outran their evidence. Every entry links to the public posts it is based on. Severity is measured in handshakes."
  >
    <div class="stats">
      <div><Ticker class="num" value={INCIDENTS.length} /><span>Incidents</span></div>
      {
        Object.entries(counts).map(([k, v]) => (
          <div>
            <Ticker class="num" value={v} />
            <span>{k}</span>
          </div>
        ))
      }
    </div>
  </PageHead>

  <section class="container list">
    {
      sorted.map((inc) => <IncidentCard inc={inc} />)
    }
  </section>

  <section class="container section" id="commendations">
    <div class="section-head">
      <span class="eyebrow">Registry of exemplary practice</span>
      <h2 class="h1">Commendations</h2>
      <p>Benchmarks and people who published their data, their code, or the sentence "we were unable to replicate". None of them are trust-me-bro. All of them are, as a result, less fun to parody.</p>
    </div>
    <div class="comm">
      {
        COMMENDATIONS.map((c) => {
          const t = tweetById(c.tweetId);
          return (
            <a class="card cm" href={tweetUrl(t)} target="_blank" rel="noopener">
              <span class="badge badge-good">✓ Reproducible</span>
              <h3>{c.name}</h3>
              <p class="who">{c.author}</p>
              <p>{c.why}</p>
              <span class="src">View source post ↗</span>
            </a>
          );
        })
      }
    </div>
  </section>
</Base>

<style>
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }
  .stats div {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 12px 18px;
    display: flex;
    flex-direction: column;
    min-width: 120px;
  }
  .stats :global(.num) {
    font-family: var(--serif);
    font-size: 30px;
    font-weight: 450;
    line-height: 1.1;
  }
  .stats > div > span:last-child {
    font-size: 13px;
    color: var(--muted);
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .comm {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 14px;
  }
  .cm {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-start;
  }
  .cm:hover {
    border-color: var(--good);
  }
  .cm h3 {
    font-family: var(--serif);
    font-weight: 450;
    font-size: 22px;
    margin: 8px 0 0;
  }
  .cm .who {
    margin: 0;
    color: var(--muted);
    font-size: 13.5px;
  }
  .cm p {
    margin: 0;
    font-size: 14px;
    color: var(--ink-2);
  }
  .cm .src {
    margin-top: auto;
    padding-top: 8px;
    font-size: 12.5px;
    color: var(--accent);
    font-weight: 550;
  }
</style>
